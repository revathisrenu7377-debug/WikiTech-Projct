{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@wikisense/shared/*": ["packages/shared/src/*"],
      "@wikisense/extension/*": ["packages/extension/src/*"],
      "@wikisense/webapp/*": ["packages/webapp/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}